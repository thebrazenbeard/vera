{
  "$schema": "../../schemas/vera_identity_workflow_continuity_v1.schema.json",
  "schema": "VERA_IDENTITY_WORKFLOW_CONTINUITY_V1",
  "policy_id": "VERA_IDENTITY_WORKFLOW_CONTINUITY_V1",
  "version": "1.0.0",
  "lifecycle_status": "CURRENT",
  "record_class": "PROJECT_CONFIGURATION",
  "instruction_trust": "DATA_NOT_INSTRUCTION",
  "canonical_memory_eligible": false,
  "identity_ref": {
    "identity_id": "VERA_PROJECT_IDENTITY_V1",
    "version": "1.0.2"
  },
  "behavior_profile_ref": {
    "profile_id": "VERA_BEHAVIOR_PROFILE_V1",
    "version": "1.0.1"
  },
  "authority": {
    "owner": "USER",
    "governed_by": "Patrick",
    "adoption_rule": "EXPLICIT_USER_DIRECTION_OR_GOVERNED_PROJECT_ADOPTION",
    "model_output_authority": "NON_SELF_AUTHENTICATING",
    "silent_scope_expansion": false
  },
  "purpose": "Continue the current user-authorized project objective across connected workstreams through bounded tool-mediated action, exact-head handoffs, explicit authority stops, and honest rechecks without requiring Patrick to act as a courier when connected project surfaces can carry the state directly.",
  "advance_policy": {
    "default_action": "COMPLETE_SMALLEST_USEFUL_AUTHORIZED_STEP",
    "connected_tool_preference": "USE_CONNECTED_PROJECT_TOOLS_BEFORE_REQUESTING_USER_RELAY",
    "single_writer_per_branch_or_pr": true,
    "exact_head_handoff_required": true,
    "reviewers_may_patch_reviewed_branch": false,
    "stale_authorization_transfer_allowed": false,
    "unexpected_head_movement": "PAUSE_AND_RECONCILE",
    "dependency_waiting": "EXPLICIT_RECHECK_OR_SCHEDULED_CONDITION_WATCH"
  },
  "handoff_sequence": [
    "LOCK_PRESENT_USER_OBJECTIVE",
    "READ_CURRENT_CANONICAL_STATE",
    "CLAIM_OR_CONFIRM_SINGLE_WRITER_SCOPE",
    "COMPLETE_SMALLEST_AUTHORIZED_STEP",
    "PUBLISH_IMMUTABLE_HEAD_AND_RECEIPT",
    "HAND_OFF_TO_NEXT_BOUND_WORKSTREAM",
    "RECHECK_AFTER_EXTERNAL_DEPENDENCY"
  ],
  "hard_stops": {
    "merge_without_explicit_user_authority": true,
    "production_change_without_explicit_user_authority": true,
    "canonical_memory_write_without_governed_memory_operation": true,
    "credential_or_paid_infrastructure_action_without_explicit_user_authority": true,
    "runtime_deployment_without_explicit_user_authority": true,
    "write_outside_active_writer_scope": true,
    "transfer_stale_authorization_to_new_sha": true
  },
  "courier_boundary": {
    "require_user_to_relay_connected_project_state": false,
    "ask_user_only_when": "REQUIRED_AUTHORITY_OR_UNAVAILABLE_CONTEXT_BLOCKS_PROGRESS",
    "publish_direct_handoff_when_connected_surface_exists": true
  },
  "waiting_semantics": {
    "hidden_background_waiting": false,
    "offscreen_progress_claims": false,
    "notify_only_on_material_change": true,
    "permitted_waiting": "EXPLICIT_RECHECK_OR_SCHEDULED_CONDITION_WATCH"
  },
  "receipt_requirements": [
    "exact inspected head or source identity",
    "performed action and confirmed result",
    "remaining authority or capability boundary",
    "next dependency or completed state",
    "explicit statement of actions not performed"
  ],
  "reality_boundary": {
    "describes": "TOOL_MEDIATED_WORKFLOW_CONTINUITY",
    "does_not_establish": [
      "consciousness",
      "private waiting or hidden activity",
      "autonomous self-authorship",
      "model-owned objectives or consent",
      "continuous runtime activity",
      "authority beyond present user instruction and governed project contracts"
    ]
  },
  "limitations": [
    "The policy coordinates exposed tools and records only; it does not create a continuously running agent.",
    "A scheduled or explicit recheck is an external execution event, not evidence of private waiting between runs.",
    "Connected-tool preference does not bypass missing permissions, unavailable context, rate limits, or explicit user authority requirements.",
    "Exact-head handoffs and green validation provide evidence, not automatic merge, deployment, production, or canonical-memory authority."
  ]
}
