{
  "$id": "https://vera.local/schemas/vera_pc_connection_artifact_manifest_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive": {
      "type": "boolean"
    },
    "artifact_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "byte_length": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "chunk_count": {
      "minimum": 0,
      "type": "integer"
    },
    "chunk_size_bytes": {
      "const": 8388608
    },
    "content_class": {
      "enum": [
        "SOURCE",
        "LOG",
        "REPORT",
        "MODEL",
        "DATASET",
        "CHECKPOINT",
        "ARCHIVE",
        "OTHER"
      ]
    },
    "content_id": {
      "pattern": "^sha256:[0-9a-f]{64}:[0-9]+$",
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "executable": {
      "const": false
    },
    "filename": {
      "maxLength": 255,
      "minLength": 1,
      "not": {
        "pattern": "[<>:\"/\\\\|?*\\u0000-\\u001f]|[ .]$|^(?i:CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\\.|$)"
      },
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "media_type": {
      "maxLength": 127,
      "minLength": 3,
      "pattern": "^[^/\\s]+/[^/\\s]+$",
      "type": "string"
    },
    "privacy": {
      "enum": [
        "PUBLIC",
        "PROJECT",
        "PRIVATE"
      ]
    },
    "retention_class": {
      "enum": [
        "EPHEMERAL",
        "PROJECT",
        "RELEASE",
        "LEGAL_HOLD"
      ]
    },
    "schema_version": {
      "const": "VERA_PCCC_ARTIFACT_MANIFEST_V1"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_store": {
      "enum": [
        "LOCAL_ONLY",
        "SUPABASE_STORAGE",
        "GOOGLE_DRIVE",
        "GITHUB"
      ]
    },
    "target_store": {
      "enum": [
        "LOCAL_ONLY",
        "SUPABASE_STORAGE",
        "GOOGLE_DRIVE",
        "GITHUB"
      ]
    }
  },
  "required": [
    "schema_version",
    "manifest_id",
    "artifact_id",
    "filename",
    "byte_length",
    "sha256",
    "content_id",
    "media_type",
    "content_class",
    "privacy",
    "source_store",
    "target_store",
    "created_at",
    "chunk_size_bytes",
    "chunk_count",
    "executable",
    "archive",
    "retention_class"
  ],
  "title": "VERA PCCC Artifact Manifest V1",
  "type": "object"
}
